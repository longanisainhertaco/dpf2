# ✅ NEW FILE: web/backend/job_queue.py
from celery import Celery
import subprocess
import os

celery_app = Celery(
    'dpf2',
    broker=os.environ.get('CELERY_BROKER_URL', 'redis://localhost:6379/0'),
    backend=os.environ.get('CELERY_RESULT_BACKEND', 'redis://localhost:6379/0')
)

@celery_app.task(bind=True)
def run_simulation_task(self, run_id: str, config_path: str):
    '''Execute simulation via SLURM or local process.'''
    self.update_state(state='RUNNING', meta={'progress': 0})
    
    if os.environ.get('USE_SLURM', 'false').lower() == 'true':
        # Submit to SLURM cluster
        job_id = submit_slurm_job(run_id, config_path)
        return {'slurm_job_id': job_id}
    else:
        # Run locally for development
        from dpf2.simulation_engine import run_simulation
        result = run_simulation(config_path)
        return {'result': result}

def submit_slurm_job(run_id: str, config_path: str) -> str:
    '''Submit a job to SLURM scheduler.'''
    script = f'''#!/bin/bash
#SBATCH --job-name=dpf2-{run_id}
#SBATCH --output=logs/{run_id}.out
#SBATCH --error=logs/{run_id}.err
#SBATCH --time=04:00:00
#SBATCH --nodes=1

source activate dpf2
python -m dpf2 run --config {config_path}
'''
    result = subprocess.run(['sbatch'], input=script, capture_output=True, text=True)
    return result.stdout.strip().split()[-1]  # Job ID
