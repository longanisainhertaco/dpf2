import asyncio
from contextlib import asynccontextmanager

class ConnectionManager:
    def __init__(self):
        self._clients: Dict[str, set[WebSocket]] = {}
        self._lock = asyncio.Lock()
    
    async def add_client(self, key: str, ws: WebSocket):
        async with self._lock:
            self._clients.setdefault(key, set()).add(ws)
    
    async def remove_client(self, key: str, ws: WebSocket):
        async with self._lock:
            if key in self._clients:
                self._clients[key].discard(ws)
    
    async def broadcast(self, key: str, message: dict):
        async with self._lock:
            clients = list(self._clients.get(key, set()))
        for ws in clients:
            try:
                await ws.send_json(message)
