async def safe_read_json(path: Path) -> dict:
    '''Read JSON file with proper error handling.'''
    try:
        content = path.read_text()
        return json.loads(content)
    except FileNotFoundError:
        raise HTTPException(status_code=404, detail='Resource not found')
    except PermissionError:
        logger.error('Permission denied: %s', path)
        raise HTTPException(status_code=500, detail='Storage access error')
    except json.JSONDecodeError as e:
        logger.error('Invalid JSON in %s: %s', path, e)
        raise HTTPException(status_code=500, detail='Data corruption detected')

async def safe_write_json(path: Path, data: dict) -> None:
    '''Write JSON file with proper error handling.'''
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data, indent=2))
    except PermissionError:
        logger.error('Permission denied writing: %s', path)
        raise HTTPException(status_code=500, detail='Storage write error')
    except OSError as e:
        logger.error('OS error writing %s: %s', path, e)
        raise HTTPException(status_code=500, detail='Storage error')
