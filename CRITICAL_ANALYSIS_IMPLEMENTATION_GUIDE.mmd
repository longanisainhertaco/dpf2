# ✅ validation/uq_pipeline/sensitivity_analysis.py
import numpy as np
from SALib.sample import saltelli
from SALib.analyze import sobol
from typing import Dict, List, Callable

class SensitivityAnalyzer:
    '''Global sensitivity analysis for DPF simulations.'''
    
    def __init__(self, model: Callable, parameters: Dict[str, tuple]):
        '''
        model: Function mapping parameter dict -> output dict
        parameters: {'param_name': (min, max), ...}
        '''
        self.model = model
        self.problem = {
            'num_vars': len(parameters),
            'names': list(parameters.keys()),
            'bounds': list(parameters.values())
        }
    
    def run_sobol_analysis(self, n_samples: int = 1024) -> Dict:
        '''Run Sobol sensitivity analysis.'''
        # Generate samples
        param_values = saltelli.sample(self.problem, n_samples)
        
        # Run model for each sample
        Y = np.array([self.model(dict(zip(self.problem['names'], x))) 
                      for x in param_values])
        
        # Analyze
        Si = sobol.analyze(self.problem, Y)
        return {
            'first_order': dict(zip(self.problem['names'], Si['S1'])),
            'total_order': dict(zip(self.problem['names'], Si['ST'])),
            'confidence': Si['S1_conf']
        }

# Usage for neutron yield sensitivity:
analyzer = SensitivityAnalyzer(
    model=run_dpf_simulation,
    parameters={
        'pressure_mbar': (1, 10),
        'voltage_kV': (15, 30),
        'anode_radius_cm': (0.5, 2.0)
    }
)
results = analyzer.run_sobol_analysis(n_samples=2048)
