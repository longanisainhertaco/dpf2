import numpy as np
from typing import Tuple

class HallMHDSolver:
    '''3D Hall-MHD solver with constrained transport.'''
    
    def __init__(self, grid: 'Grid3D', eta: float, eta_H: float):
        self.grid = grid
        self.eta = eta        # Resistivity
        self.eta_H = eta_H    # Hall coefficient = c/(4*pi*n*e)
        
    def compute_hall_field(
        self, 
        J: np.ndarray,  # Current density [3, nx, ny, nz]
        B: np.ndarray   # Magnetic field [3, nx, ny, nz]
    ) -> np.ndarray:
        '''E_H = (eta_H / |B|) * (J x B)'''
        B_mag = np.linalg.norm(B, axis=0, keepdims=True) + 1e-10
        JxB = np.cross(J, B, axis=0)
        return (self.eta_H / B_mag) * JxB
    
    def constrained_transport_update(
        self,
        B: np.ndarray,
        E: np.ndarray,
        dt: float
    ) -> np.ndarray:
        '''CT update: dB/dt = -curl(E), preserves div(B)=0'''
        curl_E = self._compute_curl(E)
        return B - dt * curl_E
